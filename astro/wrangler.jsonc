// Cloudflare Worker that serves the built site (dist/) as static files at yorkshireschoolchecker.co.uk.
// Cloudflare builds it from GitHub with root directory "astro", build command "npm run build"
// and deploy command "npx wrangler deploy". The name must match the Worker's name in Cloudflare.
{
  "name": "yorkshire-school-checker",
  "compatibility_date": "2026-10-01",
  // only /api/* runs the Worker code (the advertising enquiry form); everything else is a static file
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    // unknown addresses get the site's own "page not found" page with a 404 status
    "not_found_handling": "404-page"
  },
  // lets branch builds publish a preview link with "npx wrangler preview" (Preview settings in Cloudflare)
  "previews": {},
  // emails enquiries to one fixed, verified address (Email Service > Email Routing > Destination Addresses)
  "send_email": [{ "name": "ENQUIRY", "destination_address": "jake.adams1307@gmail.com" }]
}
