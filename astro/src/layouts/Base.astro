---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { url } from '../lib/url';
import { COVERED } from '../lib/specs';
import frauncesFont from '../assets/fonts/fraunces-latin.woff2?url';
import bodyFont from '../assets/fonts/instrument-sans-latin.woff2?url';
import '../styles/fonts.css';
import '../styles/global.css';
// index: false keeps a page out of search results (the 404 page)
// track: the name the visitor counts use for this page, when it isn't the address (the 404 page)
interface Props { title: string; description: string; active?: 'plan' | 'find' | 'how'; index?: boolean; track?: string }
const { title, description, active, index = true, track } = Astro.props;
// the one address search engines should list, whichever host served the page (www, workers.dev)
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// the picture card shown when a link is shared on WhatsApp, Facebook and the like
const shareImage = new URL(url('share.png'), Astro.site).href;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <!-- Google tag (Tag Manager GTM-T5VDVN69, GA4 G-NR6T0LHP0J), first in <head> as Google asks. Analytics cookies
         run for visit statistics only, under PECR's statistical-purposes exception (Data (Use and Access) Act 2025):
         the cookie notice tells visitors, and "Turn off" (lib/consent.ts, CookieBanner.astro) stops them. Advertising
         features are always off. The address Google is given never has a postcode in it, and the site owner's own
         browser (marked by opening /admin) is switched off with Google's own opt-out flag. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      (function () {
        var owner = false, off = false;
        try {
          owner = localStorage.getItem('ysc-owner') === '1';
          var c = JSON.parse(localStorage.getItem('ysc-consent') || 'null');
          off = !!c && c.c === 'denied';
        } catch (e) {}
        if (owner || off) window['ga-disable-G-NR6T0LHP0J'] = true;
        gtag('consent', 'default', { analytics_storage: owner || off ? 'denied' : 'granted', ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied' });
        var q = new URLSearchParams(location.search); q.delete('pc'); q.delete('school');
        var qs = q.toString();
        gtag('set', { page_location: location.origin + location.pathname + (qs ? '?' + qs : ''), allow_google_signals: false, allow_ad_personalization_signals: false });
      })();
      gtag('js', new Date());
    </script>
    <script is:inline async src="https://www.googletagmanager.com/gtm.js?id=GTM-T5VDVN69"></script>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {index ? <link rel="canonical" href={canonical} /> : <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Yorkshire School Checker" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {index && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`Yorkshire School Checker: which primary schools in ${COVERED} could your child get into?`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#FFFFFF" />
    <link rel="icon" href={url('favicon.ico')} sizes="32x32" />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    <link rel="preload" href={frauncesFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <slot name="head" />
  </head>
  <body data-page={track}>
    <a class="skip" href="#main">Skip to content</a>
    <Header active={active} />
    <main id="main"><slot /></main>
    <Footer />
    <div class="toast" id="toast" role="status" aria-live="polite" hidden></div>
    <CookieBanner />
    <script>
      // daily visitor counts for the admin dashboard (no cookies, nothing that identifies anyone, and never the
      // site owner's own browsing: lib/consent.ts). Google Analytics is separate, and only runs after an Accept.
      import { startTracking } from '../lib/track';
      startTracking(document.body.dataset.page || location.pathname.toLowerCase().replace(/\/?$/, '/'));
    </script>
  </body>
</html>
