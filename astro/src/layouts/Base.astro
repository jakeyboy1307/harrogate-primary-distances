---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { url } from '../lib/url';
import '../styles/global.css';
// index: false keeps a page out of search results (the 404 page)
interface Props { title: string; description: string; active?: 'plan' | 'find' | 'how'; index?: boolean }
const { title, description, active, index = true } = Astro.props;
// the one address search engines should list, whichever host served the page (www, workers.dev)
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {index ? <link rel="canonical" href={canonical} /> : <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Yorkshire School Checker" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {index && <meta property="og:url" content={canonical} />}
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <slot name="head" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Instrument+Sans:wght@400;500;600;700&display=swap" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header active={active} />
    <main id="main"><slot /></main>
    <Footer />
    <div class="toast" id="toast" role="status" aria-live="polite" hidden></div>
  </body>
</html>
