---
// The cookie notice. Google Analytics runs for visit statistics without asking first, which PECR allows since the
// Data (Use and Access) Act 2025 as long as visitors are told and can object simply: this notice tells them, and
// "Turn off" objects (lib/consent.ts). Shown until the visitor picks OK or Turn off, and again from "Cookie
// settings" in the footer.
import { url } from '../lib/url';
---
<section class="cc" id="cc" aria-labelledby="ccTitle" hidden>
  <h2 class="cc-title" id="ccTitle">We count visits with Google Analytics</h2>
  <p class="cc-text">Its cookies show us which pages help parents most. They don’t follow you to other sites, there are no ads, and your postcode is never shared. You can turn them off. <a href={url('privacy/#cookies')}>More about cookies</a></p>
  <div class="cc-acts">
    <button type="button" class="btn cc-btn" id="ccReject">Turn off</button>
    <button type="button" class="btn cc-btn" id="ccAccept">OK</button>
  </div>
</section>

<script>
  import { getChoice, grantAnalytics, isOwner, setChoice, stopAnalytics } from '../lib/consent';
  const box = document.getElementById('cc')!;
  const show = () => { box.hidden = false; };
  const hide = () => { box.hidden = true; };

  if (!isOwner() && getChoice() === null) show();
  document.getElementById('ccAccept')!.addEventListener('click', () => { setChoice('granted'); hide(); grantAnalytics(); });
  document.getElementById('ccReject')!.addEventListener('click', () => { setChoice('denied'); hide(); stopAnalytics(); });
  // "Cookie settings" in the footer, and the button on the privacy page
  document.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('[data-cookie-settings]')) { show(); document.getElementById('ccTitle')!.scrollIntoView({ block: 'nearest' }); }
  });
</script>

<style>
  .cc { position: fixed; left: 16px; bottom: 16px; z-index: 2000; width: min(460px, calc(100vw - 32px)); display: grid; gap: 10px; padding: 20px 22px; background: #fff; color: var(--ink); border: 2.5px solid var(--ink); border-radius: 18px; box-shadow: 6px 6px 0 var(--ink); }
  .cc[hidden] { display: none; }
  .cc-title { font: 700 19px/1.25 var(--display); letter-spacing: -0.01em; }
  .cc-text { font-size: 15px; line-height: 1.5; color: var(--muted); }
  .cc-text a { color: var(--ink); font-weight: 600; }
  .cc-acts { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 4px; }
  .cc-btn { padding: 11px 16px; font-size: 16px; }
  @media (max-width: 760px) { .cc { left: 12px; bottom: 12px; width: calc(100vw - 24px); padding: 16px 18px; } }
</style>
