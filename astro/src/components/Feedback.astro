---
// The footer's "Contact us" button and its popup, also opened by the About page's "Send us a message". Messages go
// to the site's Worker (POST /api/message, worker/index.js), which emails them to the site owner with Reply-To set
// to the sender. Nothing is saved; privacy.astro says so.
---
<button type="button" class="feedback-btn" id="fbOpen" aria-haspopup="dialog">Contact us</button>

<dialog class="fb" id="fbDialog" aria-labelledby="fbTitle">
  <form class="fb-form" id="fbForm" novalidate>
    <div class="fb-head">
      <h2 id="fbTitle">Send us a message</h2>
      <button type="button" class="close" id="fbClose" aria-label="Close">
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" /></svg>
      </button>
    </div>
    <p class="fb-intro">Spotted a mistake, a missing school, or have a question? We read every message and reply by email.</p>
    <label class="fb-field">
      <span>Your name</span>
      <input type="text" name="name" id="fbName" autocomplete="name" maxlength="120" required />
    </label>
    <label class="fb-field">
      <span>Your email</span>
      <input type="email" name="email" autocomplete="email" maxlength="200" required />
    </label>
    <label class="fb-field">
      <span>Your message</span>
      <textarea name="message" rows="5" required maxlength="5000"></textarea>
    </label>
    <!-- left empty by people; bots tend to fill it in -->
    <label class="fb-hp" aria-hidden="true">Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
    <p class="fb-note">We only use your email to reply. <a href="/privacy/">Privacy</a></p>
    <p class="fb-status" id="fbStatus" role="status" aria-live="polite"></p>
    <div class="fb-acts"><button type="submit" class="btn btn-primary" id="fbSend">Send message</button></div>
  </form>
  <div class="fb-done" id="fbDone" hidden>
    <span class="hand">thank you!</span>
    <h2>Message sent.</h2>
    <p>Thanks for getting in touch. We’ll reply to the email you gave.</p>
    <button type="button" class="btn" id="fbDoneClose">Close</button>
  </div>
</dialog>

<script>
  const ENDPOINT = `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}api/message`;
  const dlg = document.getElementById('fbDialog') as HTMLDialogElement;
  const form = document.getElementById('fbForm') as HTMLFormElement;
  const done = document.getElementById('fbDone')!;
  const status = document.getElementById('fbStatus')!;
  const send = document.getElementById('fbSend') as HTMLButtonElement;
  const say = (t: string, err = false) => { status.textContent = t; status.classList.toggle('err', err); };

  document.getElementById('fbOpen')!.addEventListener('click', () => {
    form.hidden = false; done.hidden = true; say('');
    dlg.showModal();
    (document.getElementById('fbName') as HTMLInputElement).focus();
  });
  for (const id of ['fbClose', 'fbDoneClose']) document.getElementById(id)!.addEventListener('click', () => dlg.close());
  // a click on the dimmed backdrop closes it
  dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });

  form.addEventListener('input', () => say(''));
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
    if (!data.name?.trim()) return say('Please add your name.', true);
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(data.email ?? '')) return say('Please add an email address we can reply to.', true);
    if (!data.message?.trim()) return say('Write a message first.', true);
    send.disabled = true; send.textContent = 'Sending…'; say('');
    try {
      const r = await fetch(ENDPOINT, {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ...data, page: location.pathname + location.hash }),
      });
      if (!r.ok) throw new Error(String(r.status));
      form.reset(); form.hidden = true; done.hidden = false;
    } catch {
      say('Sorry, that didn’t send. Check your connection and try again.', true);
    } finally {
      send.disabled = false; send.textContent = 'Send message';
    }
  });
</script>
