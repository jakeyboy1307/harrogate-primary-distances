---
import Rose from './Rose.astro';
import Mammoth from './Mammoth.astro';
import Feedback from './Feedback.astro';
import { url } from '../lib/url';
import { AREA_INFO, councilLabel } from '../lib/specs';
import { HUBS } from '../lib/hubs';
import { byCouncil } from '../lib/places';
// One link per council: its council page, or its only (or first) area page where it has none (York, Wakefield).
// The 57 areas and 140 towns are on /areas/ and in the "Find your town" box, not listed here.
const councils = byCouncil().map(([c, areas]) => ({ name: councilLabel(c), page: HUBS[c]?.page ?? AREA_INFO[areas[0]].page }));
---
<footer class="site-foot">
  <div class="foot-nav">
    <form class="foot-find" action={url('areas/')} method="get" role="search" data-places={url('places.json')}>
      <label for="footQ">Find your town</label>
      <div class="foot-find-row">
        <input id="footQ" name="q" type="search" list="footPlaces" placeholder="Ripon, Roundhay, Hebden Bridge…" autocomplete="off" />
        <button class="btn btn-sm" type="submit">Go</button>
      </div>
      <datalist id="footPlaces"></datalist>
      <a class="foot-all" href={url('areas/')}>See every area and town</a>
    </form>
    <nav class="foot-councils" aria-label="Primary schools by council">
      <span>Primary schools by council</span>
      <ul>{councils.map((c) => <li><a href={url(c.page)}>{c.name}</a></li>)}</ul>
    </nav>
  </div>
  <div class="foot-bottom">
    <div class="foot-id">
      <a class="foot-brand" href={url('')}><Rose size={28} /><span>Yorkshire School Checker</span></a>
      <p class="foot-tag">An independent tool, not run by any council or school.</p>
    </div>
    <nav class="foot-links" aria-label="Footer">
      <a href={url('')}>Find schools</a>
      <a href={url('plan/')}>My plan</a>
      <a href={url('how-places-work/')}>How places work</a>
      <a href={url('how-places-work/#sources')}>Where our numbers come from</a>
      <a href={url('about/')}>About</a>
      <Feedback />
      <a href={url('privacy/')}>Privacy</a>
      <button type="button" class="cc-open" data-cookie-settings>Cookie settings</button>
    </nav>
  </div>
  <div class="foot-base">
    <p class="foot-biz">Local business? <a href={url('advertise/')}>Advertise with us</a></p>
    <p class="credit">
      <span>Made by</span>
      <a class="credit-link" href="https://www.mammothwebsites.co.uk" target="_blank" rel="noopener"><Mammoth /><span>Mammoth Websites</span></a>
    </p>
  </div>
</footer>

<script>
  // "Find your town": suggestions load the first time someone uses the box (pages/places.json.ts). Picking one, or
  // typing a name and pressing Go, opens its page; anything else goes to /areas/ with the list narrowed to it.
  const form = document.querySelector<HTMLFormElement>('.foot-find')!;
  const input = form.querySelector('input')!, list = form.querySelector('datalist')!;
  let places: [string, string][] | null = null, loading: Promise<void> | null = null;
  const load = () => (loading ??= fetch(form.dataset.places!).then((r) => r.json()).then((p: [string, string][]) => {
    places = p;
    list.innerHTML = p.map(([n]) => `<option value="${n.replace(/"/g, '&quot;')}"></option>`).join('');
  }).catch(() => {}));
  const find = (v: string) => {
    const q = v.trim().toLowerCase();
    if (!q || !places) return undefined;
    return places.find(([n]) => n.toLowerCase() === q) ?? places.find(([n]) => n.toLowerCase().startsWith(q));
  };
  input.addEventListener('focus', load, { once: true });
  input.addEventListener('input', load, { once: true });
  // a suggestion picked from the list fills the box in one go (no typing): go straight there
  input.addEventListener('input', (e) => {
    const t = (e as InputEvent).inputType;
    if (t && t !== 'insertReplacementText') return;
    const hit = places?.find(([n]) => n.toLowerCase() === input.value.trim().toLowerCase());
    if (hit) location.href = hit[1];
  });
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    await load();
    const hit = find(input.value);
    location.href = hit ? hit[1] : `${form.action}?q=${encodeURIComponent(input.value.trim())}`;
  });
</script>
