---
import Rose from './Rose.astro';
import Mammoth from './Mammoth.astro';
import Feedback from './Feedback.astro';
import { url } from '../lib/url';
import { AREA_INFO } from '../lib/specs';
---
<footer class="site-foot">
  <div class="foot-brand"><Rose size={26} /><span>Yorkshire School Checker</span></div>
  <nav class="foot-links" aria-label="Footer">
    <a href={url('')}>Find schools</a>
    <a href={url('plan/')}>My plan</a>
    <a href={url('how-places-work/')}>How places work</a>
    <a href={url('how-places-work/#sources')}>Where our numbers come from</a>
    <a href={url('privacy/')}>Privacy</a>
  </nav>
  <div class="foot-nav">
    <nav class="foot-areas" aria-label="Areas we cover">
      <span>Areas we cover</span>
      {Object.values(AREA_INFO).map((a) => <a href={url(a.page)}>{a.name} primary schools</a>)}
    </nav>
    <nav class="foot-areas" aria-label="For businesses">
      <span>For businesses</span>
      <a href={url('advertise/')}>Advertise with us</a>
    </nav>
  </div>
  <div class="foot-fb"><Feedback /></div>
  <hr class="foot-rule" />
  <p class="foot-legal">An independent tool, not run by North Yorkshire Council, City of York Council or any school.</p>
  <p class="credit">
    <span>Made by</span>
    <a class="credit-link" href="https://www.mammothwebsites.co.uk" target="_blank" rel="noopener"><Mammoth /><span>Mammoth Websites</span></a>
  </p>
</footer>
