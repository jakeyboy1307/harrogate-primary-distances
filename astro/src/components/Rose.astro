---
// The Yorkshire rose from the live site's header
interface Props { size?: number }
const { size = 40 } = Astro.props;
---
<svg class="rose" width={size} height={size} viewBox="-12 -12 24 24" aria-hidden="true">
  <g fill="#4F8F5A">
    <path d="M0-11.6 2-6.2H-2Z" transform="rotate(36)" /><path d="M0-11.6 2-6.2H-2Z" transform="rotate(108)" />
    <path d="M0-11.6 2-6.2H-2Z" transform="rotate(180)" /><path d="M0-11.6 2-6.2H-2Z" transform="rotate(252)" />
    <path d="M0-11.6 2-6.2H-2Z" transform="rotate(324)" />
  </g>
  <g fill="#fff" stroke="#14182B" stroke-width=".7">
    <circle cy="-5.2" r="4.5" /><circle cy="-5.2" r="4.5" transform="rotate(72)" /><circle cy="-5.2" r="4.5" transform="rotate(144)" />
    <circle cy="-5.2" r="4.5" transform="rotate(216)" /><circle cy="-5.2" r="4.5" transform="rotate(288)" />
  </g>
  <circle r="2.7" fill="#FFD23F" stroke="#14182B" stroke-width=".5" />
</svg>
