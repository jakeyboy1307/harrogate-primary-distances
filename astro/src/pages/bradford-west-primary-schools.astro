---
// Area page: Bradford's bradfordwest area (lib/specs.ts AREA_INFO). The questions every Bradford page shares are in lib/bradford.ts.
import AreaPage from '../components/AreaPage.astro';
import { loadArea, openLatest } from '../lib/areas';
import { bdBorder, bdFaqs, bdTail } from '../lib/bradford';
import { AREA_INFO } from '../lib/specs';
const info = AREA_INFO.bradfordwest;
const schools = loadArea('bradford.json').filter((s) => info.constituencies!.includes(s.con!));
const faqs: [string, string][] = [
  ...bdFaqs('Bradford West', schools, openLatest(schools).length),
  bdBorder('Bradford', 'From Halifax or Illingworth, that’s Calderdale Council'),
  ...bdTail,
];
---
<AreaPage areaKey="bradfordwest"
  title="Bradford West primary schools: Manningham, Heaton, Allerton · Yorkshire School Checker"
  description="Primary schools in Bradford West, from Manningham, Girlington and Heaton to Allerton, Clayton and Thornton: how far places went each year, which are hardest to get into, Ofsted ratings and the 2027 Reception dates."
  h1="Bradford West primary schools"
  lede="Every primary school in Bradford West: Manningham, Girlington, Heaton, Frizinghall, Lidget Green, Allerton, Clayton, Thornton and Denholme."
  area="Bradford West"
  schools={schools}
  groups={[{ label: 'Bradford West', note: `${schools.length} Bradford primary schools. Most don’t have catchment areas, so the checker shows how far places went at each one.`, schools }]}
  faqs={faqs}
/>
