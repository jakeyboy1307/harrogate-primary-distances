---
// Where the checker covers, on a map of the UK: every council district outlined, the ones with our schools shaded
// (fully where every primary school is in, partly where only some are), our catchment areas and schools on top.
// Below the map, each area's schools, searches and live ads. Districts come from public/geo/uk-districts.json
// (scripts/uk-districts.mjs); which district each area is built around is AREA_HOME in lib/specs.ts.
import Admin from '../../../layouts/Admin.astro';
---
<Admin title="Coverage" active="coverage">
  <section class="adm-stats" aria-label="Coverage totals">
    <div class="adm-card adm-stat"><span>Areas live</span><b data-t="areas">–</b></div>
    <div class="adm-card adm-stat"><span>Districts reached</span><b data-t="districts">–</b><small data-t="districtsSub"></small></div>
    <div class="adm-card adm-stat"><span>Primary schools</span><b data-t="schools">–</b></div>
    <div class="adm-card adm-stat"><span>Catchment areas</span><b data-t="catch">–</b></div>
    <div class="adm-card adm-stat"><span>Searches outside our areas</span><b data-t="outside">–</b><small>last 30 days</small></div>
  </section>

  <section class="cov-wrap">
    <div class="adm-card cov-mapcard">
      <div class="cov-tools">
        <div class="seg" role="group" aria-label="Zoom to">
          <button type="button" data-view="uk" aria-pressed="true">Whole UK</button>
          <button type="button" data-view="ours" aria-pressed="false">Our coverage</button>
        </div>
        <span class="grow"></span>
        <label class="cov-toggle"><input type="checkbox" id="showCatch" checked /> Catchment areas</label>
        <label class="cov-toggle"><input type="checkbox" id="showSchools" checked /> Schools</label>
      </div>
      <div class="cov-map" id="map" role="img" aria-label="Map of the UK showing the council districts the checker covers"></div>
      <div class="cov-key" aria-label="Key">
        <span><i class="sw full"></i>Fully covered district</span>
        <span><i class="sw part"></i>Partly covered district</span>
        <span><i class="sw catch"></i>Catchment area</span>
        <span><i class="sw dot"></i>School</span>
      </div>
    </div>
    <aside class="cov-side">
      <h2 class="adm-h2">Live areas</h2>
      <div id="areas"><p class="adm-note">Loading…</p></div>
      <p class="adm-note cov-explain"><b>Fully covered</b> means every primary school in the district is in the checker (junior schools, which start at Year 3, aren’t). <b>Partly covered</b> means only the schools within reach of one of our areas.</p>
    </aside>
  </section>

  <section>
    <h2 class="adm-h2">Districts with our schools</h2>
    <div class="adm-table-wrap">
      <table class="adm-table">
        <thead><tr><th>District</th><th>Area</th><th>Coverage</th><th class="r">Schools</th><th class="r">With a catchment</th></tr></thead>
        <tbody id="rows"><tr><td colspan="5" class="adm-empty">Loading…</td></tr></tbody>
      </table>
    </div>
    <p class="adm-note cov-src">District outlines: ONS Local Authority Districts, December 2022 (before North Yorkshire’s districts merged), so Harrogate still shows as its own district. Contains OS data © Crown copyright and database right 2022.</p>
  </section>
</Admin>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';
  import { api, esc, type Ad } from '../../../lib/admin';
  import { inArea, loadData, type Area as Shape, type LatLng, type School } from '../../../lib/engine';
  import { areaOf } from '../../../lib/sponsors';
  import { AREA_HOME, AREAS, type Area } from '../../../lib/specs';

  interface District { code: string; name: string; p: LatLng[][][]; box?: [number, number, number, number] }
  interface Reach { d: District; schools: School[]; areas: Set<Area>; full: boolean }

  const COBALT = '#2747D8', INK = '#14182B', FAINT = '#9AA3C7';
  const UK: L.LatLngBoundsExpression = [[49.9, -8.2], [60.9, 1.8]];
  const num = (n: number) => n.toLocaleString('en-GB');
  const set = (k: string, v: string) => document.querySelectorAll<HTMLElement>(`[data-t="${k}"]`).forEach((el) => (el.textContent = v));
  const homes = new Set(Object.values(AREA_HOME).flat());

  // the bounding box of a district, so most point checks are a quick rejection
  function boxOf(d: District) {
    let a = 90, b = 180, c = -90, e = -180;
    for (const poly of d.p) for (const [y, x] of poly[0]) { a = Math.min(a, y); b = Math.min(b, x); c = Math.max(c, y); e = Math.max(e, x); }
    return (d.box = [a, b, c, e]);
  }
  const inBox = ([y, x]: LatLng, [a, b, c, e]: [number, number, number, number]) => y >= a && y <= c && x >= b && x <= e;

  async function main() {
    const [data, geo, ads, stats, opens] = await Promise.all([
      loadData(),
      fetch('/geo/uk-districts.json').then((r) => r.json() as Promise<{ districts: District[] }>),
      api<Ad[]>('ads').catch(() => [] as Ad[]),
      api<{ searches: { key: string; n: number }[] }>('stats?days=30').catch(() => null),
      api<Record<string, number>>('school-opens?days=30').catch(() => ({} as Record<string, number>)),
    ]);
    const { schools, catch: catches } = data;
    const districts = geo.districts;
    districts.forEach(boxOf);

    // which district each school is in
    const reach = new Map<string, Reach>();
    const districtOf = new Map<number, District>();
    for (const s of schools) {
      const d = districts.find((x) => inBox(s.ll, x.box!) && inArea(s.ll, x as unknown as Shape));
      if (!d) continue;
      districtOf.set(s.urn, d);
      const r = reach.get(d.code) ?? { d, schools: [], areas: new Set<Area>(), full: homes.has(d.code) };
      r.schools.push(s); r.areas.add(areaOf(s));
      reach.set(d.code, r);
    }
    const covered = [...reach.values()].sort((a, b) => Number(b.full) - Number(a.full) || b.schools.length - a.schools.length);
    const searches = Object.fromEntries((stats?.searches ?? []).map((r) => [r.key, r.n]));

    // ---------- totals ----------
    set('areas', num(Object.keys(AREAS).length));
    set('districts', num(covered.length));
    set('districtsSub', `${covered.filter((r) => r.full).length} fully, ${covered.filter((r) => !r.full).length} partly`);
    set('schools', num(schools.length));
    set('catch', num(catches.length));
    set('outside', stats ? num(searches.outside ?? 0) : 'n/a');

    // ---------- the map ----------
    const map = L.map('map', { preferCanvas: true, zoomSnap: 0.25, minZoom: 5, maxZoom: 15 });
    L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Light_Gray_Base/MapServer/tile/{z}/{y}/{x}', {
      maxZoom: 16,
      attribution: 'Tiles © Esri · Districts: ONS, contains OS data © Crown copyright 2022 · Catchments: North Yorkshire Council, City of York Council',
    }).addTo(map);

    const districtLayer = L.layerGroup().addTo(map);
    for (const d of districts) {
      const r = reach.get(d.code);
      const style: L.PathOptions = r?.full ? { color: COBALT, weight: 1.6, fillColor: COBALT, fillOpacity: 0.42 }
        : r ? { color: COBALT, weight: 1.2, dashArray: '4 3', fillColor: COBALT, fillOpacity: 0.16 }
        : { color: FAINT, weight: 0.6, fillColor: '#fff', fillOpacity: 0.01 };
      const tip = r ? `<b>${esc(d.name)}</b><br>${r.full ? 'Fully covered' : 'Partly covered'} · ${r.schools.length} school${r.schools.length === 1 ? '' : 's'}`
        : `<b>${esc(d.name)}</b><br>Not covered yet`;
      L.polygon(d.p, style).bindTooltip(tip, { sticky: true }).addTo(districtLayer);
    }

    const catchLayer = L.layerGroup(catches.map((c) => L.polygon(c.p, { color: COBALT, weight: 0.7, fillColor: COBALT, fillOpacity: 0.14, interactive: false }))).addTo(map);
    const schoolLayer = L.layerGroup(schools.map((s) => L.circleMarker(s.ll, { radius: 3.5, color: '#fff', weight: 1, fillColor: INK, fillOpacity: 1 })
      .bindTooltip(`<b>${esc(s.name)}</b><br>${esc(s.place)} · ${esc(districtOf.get(s.urn)?.name ?? '')}`))).addTo(map);

    const ours = L.latLngBounds(covered.flatMap((r) => r.d.p.flatMap((poly) => poly[0])));
    map.fitBounds(UK);
    const view = (v: string) => {
      document.querySelectorAll<HTMLButtonElement>('[data-view]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.view === v)));
      if (v === 'uk') map.flyToBounds(UK, { duration: 0.6 }); else map.flyToBounds(ours, { padding: [24, 24], duration: 0.6 });
    };
    document.querySelectorAll<HTMLButtonElement>('[data-view]').forEach((b) => b.addEventListener('click', () => view(b.dataset.view!)));
    const toggle = (id: string, layer: L.LayerGroup) => document.getElementById(id)!.addEventListener('change', (e) => {
      if ((e.target as HTMLInputElement).checked) layer.addTo(map); else layer.remove();
    });
    toggle('showCatch', catchLayer);
    toggle('showSchools', schoolLayer);
    // school dots only once zoomed in to a region: across the whole UK they merge into one blob
    const SCHOOL_ZOOM = 8;
    const fitDots = () => {
      const want = (document.getElementById('showSchools') as HTMLInputElement).checked && map.getZoom() >= SCHOOL_ZOOM;
      if (want && !map.hasLayer(schoolLayer)) schoolLayer.addTo(map); else if (!want && map.hasLayer(schoolLayer)) schoolLayer.remove();
    };
    map.on('zoomend', fitDots);
    document.getElementById('showSchools')!.addEventListener('change', fitDots);
    fitDots();

    // ---------- each live area ----------
    const showing = ads.filter((a) => a.state === 'showing');
    document.getElementById('areas')!.innerHTML = (Object.entries(AREAS) as [Area, string][]).map(([key, label]) => {
      const mine = schools.filter((s) => areaOf(s) === key);
      const dists = covered.filter((r) => r.areas.has(key)).map((r) => r.d.name);
      const live = showing.filter((a) => a.areas.includes(key));
      const advertisers = new Set(live.map((a) => a.advertiserId).filter(Boolean)).size;
      const opened = mine.reduce((n, s) => n + (opens[String(s.urn)] ?? 0), 0);
      const rows: [string, string][] = [
        ['Schools', num(mine.length)],
        ['With a catchment', num(mine.filter((s) => s.cz?.length).length)],
        ['Searches, 30 days', stats ? num(searches[key] ?? 0) : 'n/a'],
        ['Schools opened, 30 days', num(opened)],
        ['Ads showing', num(live.length)],
        ['Advertisers', num(advertisers)],
      ];
      return `<button type="button" class="adm-card cov-area" data-area="${key}">
        <span class="cov-area-head"><b>${esc(label)}</b><span class="pill-s good">Live</span></span>
        <span class="sub">${esc(dists.join(', '))}</span>
        <dl>${rows.map(([k, v]) => `<div><dt>${k}</dt><dd>${v}</dd></div>`).join('')}</dl>
      </button>`;
    }).join('');
    document.querySelectorAll<HTMLButtonElement>('.cov-area').forEach((b) => b.addEventListener('click', () => {
      const pts = schools.filter((s) => areaOf(s) === b.dataset.area).map((s) => s.ll);
      document.querySelectorAll<HTMLButtonElement>('[data-view]').forEach((x) => x.setAttribute('aria-pressed', 'false'));
      map.flyToBounds(L.latLngBounds(pts), { padding: [30, 30], duration: 0.6 });
    }));

    // ---------- the districts table ----------
    document.getElementById('rows')!.innerHTML = covered.map((r) => `<tr>
      <td class="name">${esc(r.d.name)}<div class="sub">${esc(r.d.code)}</div></td>
      <td>${[...r.areas].map((a) => esc(AREAS[a])).join(', ')}</td>
      <td>${r.full ? '<span class="pill-s good">Full</span>' : '<span class="pill-s open">Part</span>'}</td>
      <td class="r">${num(r.schools.length)}</td>
      <td class="r">${num(r.schools.filter((s) => s.cz?.length).length)}</td>
    </tr>`).join('');
  }

  main().catch((e) => {
    document.getElementById('areas')!.innerHTML = `<p class="adm-error">${esc(String(e.message ?? e))}</p>`;
  });
</script>

<style is:global>
  .adm-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(170px, 100%), 1fr)); gap: 16px; }
  .adm-stat { display: grid; gap: 6px; align-content: start; }
  .adm-stat span { font-size: 14px; font-weight: 600; color: var(--muted); }
  .adm-stat b { font: 700 32px/1 var(--display); color: var(--ink); }
  .adm-stat small { font-size: 13px; color: var(--muted-2); }
  .seg { display: inline-flex; border: 1.5px solid var(--line-2); border-radius: 10px; overflow: hidden; background: #fff; }
  .seg button { border: 0; background: none; padding: 7px 12px; font: 600 13px var(--body); color: var(--muted); cursor: pointer; }
  .seg button + button { border-left: 1.5px solid var(--line-2); }
  .seg button[aria-pressed='true'] { background: var(--ink); color: #fff; }

  .cov-wrap { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 24px; align-items: start; }
  .cov-mapcard { padding: 14px; display: grid; gap: 12px; }
  .cov-tools { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
  .cov-tools .grow { flex: 1; }
  .cov-toggle { display: inline-flex; align-items: center; gap: 6px; font: 600 14px var(--body); cursor: pointer; }
  .cov-toggle input { accent-color: var(--ink); }
  .cov-map { height: 680px; border-radius: 12px; border: 1px solid var(--line); background: #F4F4F2; }
  .cov-map .leaflet-tooltip { font: 500 13px/1.4 var(--body); }
  .cov-key { display: flex; flex-wrap: wrap; gap: 8px 18px; font-size: 13px; color: var(--muted); }
  .cov-key span { display: inline-flex; align-items: center; gap: 7px; }
  .sw { display: inline-block; width: 16px; height: 12px; border-radius: 3px; }
  .sw.full { background: rgba(39, 71, 216, .42); border: 1.5px solid var(--cobalt); }
  .sw.part { background: rgba(39, 71, 216, .16); border: 1.5px dashed var(--cobalt); }
  .sw.catch { background: rgba(39, 71, 216, .14); border: 1px solid var(--cobalt); }
  .sw.dot { width: 9px; height: 9px; border-radius: 50%; background: var(--ink); box-shadow: 0 0 0 1.5px #fff, 0 0 0 2.5px var(--line-2); }

  .cov-side { display: grid; gap: 12px; }
  .cov-area { display: grid; gap: 6px; text-align: left; font: inherit; color: inherit; cursor: pointer; width: 100%; transition: border-color .15s, box-shadow .15s; }
  .cov-area + .cov-area { margin-top: 12px; }
  .cov-area:hover { border-color: var(--cobalt); box-shadow: 0 4px 14px rgba(39, 71, 216, .12); }
  .cov-area-head { display: flex; justify-content: space-between; align-items: center; gap: 10px; font-size: 16px; }
  .cov-area .sub { color: var(--muted-2); font-size: 13px; }
  .cov-area dl { display: grid; grid-template-columns: 1fr 1fr; gap: 10px 14px; margin-top: 8px; }
  .cov-area dt { font-size: 12px; color: var(--muted-2); font-weight: 600; }
  .cov-area dd { font: 700 20px var(--display); margin: 0; }
  .cov-explain, .cov-src { font-size: 13px; }
  .cov-src { margin-top: 10px; }
  .adm-table .r { text-align: right; }

  @media (max-width: 1180px) { .cov-wrap { grid-template-columns: 1fr; } .cov-map { height: 520px; } }
  @media (max-width: 600px) { .cov-map { height: 420px; } }
</style>
