---
// Area page: City of York and the North Yorkshire villages round it. Questions follow what people search for
// (Google suggestions, November 2026).
import AreaPage from '../components/AreaPage.astro';
import { loadArea } from '../lib/areas';
import { COUNCILS } from '../lib/engine';
import { nearYork, NEAR_YORK_MILES } from '../lib/specs';
import { url } from '../lib/url';
import { termAnswer } from '../lib/holidays';
const york = loadArea('york.json');
// North Yorkshire schools near York (Easingwold, Escrick, Tadcaster...): each also has its own area page
const near = loadArea('north-yorkshire.json').filter(nearYork);
const schools = [...york, ...near];
const cyc = COUNCILS.York, ny = COUNCILS['North Yorkshire'];
const faqs: [string, string][] = [
  ['What is my catchment school in York?',
    `Put your postcode into the <a href="${url('')}">school catchment checker</a>. It tells you which York primary school catchment area you’re in, and how many children got a place at each school nearby. It covers the villages round York in North Yorkshire too.`],
  ['Is there a York school catchment area map?',
    `Yes. City of York Council’s <a href="${cyc.catchMap}" target="_blank" rel="noopener">primary schools map</a> shows each school’s catchment area, and North Yorkshire Council has a <a href="${ny.catchMap}" target="_blank" rel="noopener">school catchment area map</a> for Easingwold, Selby, Tadcaster and the other villages. The checker uses both, so your postcode gives you the answer.`],
  ['When do I apply for a Reception place in York for September 2027?',
    `Apply online to <a href="${cyc.apply}" target="_blank" rel="noopener">City of York Council</a> by Friday 15 January 2027. You can name up to five schools, in the order you want them.`],
  ['When are primary school places announced?',
    'Offers go out on national offer day, Friday 16 April 2027, by email from the council.'],
  ['How do school catchment areas work in York?',
    `City of York Council fills each school’s places in order: children in care, then children in the catchment with a brother or sister at the school, then the rest of the catchment, then medical or social need, then brothers and sisters from outside it, then whoever has the shortest safe walk. <a href="${url('how-places-work/#york')}">How school catchment areas work</a> has more.`],
  ['Can my child get into a York school outside our catchment?',
    `Often, if places are left once the catchment children have theirs. York doesn’t publish how far the last place went, so the checker shows how many children from outside the catchment got in each year.`],
  ['Which are the best primary schools in York?',
    'There’s no official ranking, so be wary of league tables. Ofsted is the fairest guide, alongside a visit. The checker shows each school’s latest Ofsted outcome, and the Outstanding schools are listed above.'],
  ['I live in Haxby, Copmanthorpe or Easingwold. Which council do I apply to?',
    `Apply to the council for where you live, and name schools from either council. Haxby, Wigginton, Strensall, Copmanthorpe, Poppleton and the other villages inside the city boundary are <a href="${cyc.apply}" target="_blank" rel="noopener">City of York</a>. Easingwold, Escrick, Tadcaster, Sherburn and Selby are <a href="${ny.apply}" target="_blank" rel="noopener">North Yorkshire</a>.`],
  ['Where can I see York school admissions data?',
    'City of York Council publishes an anonymised list of every Reception applicant on <a href="https://data.yorkopendata.org/" target="_blank" rel="noopener">York Open Data</a>. The checker turns the last four complete years into plain answers for every York primary school.'],
  [`When are the York school holidays?`,
    termAnswer('York', 'York', url)],
  ['How do I find open days?',
    'Ask the school. Open the school in the checker for its phone number, email and website.'],
];
---
<AreaPage areaKey="york"
  title="York primary school catchment areas, map and Ofsted · Yorkshire School Checker"
  description="York primary school catchment areas, plus Haxby, Selby, Tadcaster and Easingwold: find your catchment school, which schools are hardest to get into, Ofsted ratings and the 2027 Reception dates."
  h1="York primary schools and catchment areas"
  lede="Primary school catchment areas for every school in York, from Acomb and Haxby to Fulford and Heslington, plus the North Yorkshire villages round York such as Easingwold, Escrick, Selby and Tadcaster."
  area="York"
  schools={schools}
  groups={[
    { label: 'In the City of York', note: `${york.length} schools in City of York Council’s admissions scheme. Junior schools, which start at Year 3, aren’t included.`, schools: york },
    { label: 'Just outside York', note: `${near.length} North Yorkshire Council schools within ${NEAR_YORK_MILES} miles of York. See also <a href="${url('selby-primary-schools/')}">Selby</a> and <a href="${url('northallerton-primary-schools/')}">Northallerton, Thirsk and Easingwold</a> primary schools.`, schools: near },
  ]}
  faqs={faqs}
/>
