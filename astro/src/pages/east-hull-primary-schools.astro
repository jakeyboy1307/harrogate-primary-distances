---
// Area page: East Hull, one of Hull's three constituencies (lib/specs.ts AREA_INFO). The questions are shared with the
// other Hull pages (lib/hull.ts). Hull's catchments can't be checked, so the page leads on how popular schools are.
import AreaPage from '../components/AreaPage.astro';
import { loadArea, openLatest } from '../lib/areas';
import { hullFaqs } from '../lib/hull';
import { AREA_INFO } from '../lib/specs';
const info = AREA_INFO.hulleast;
const schools = loadArea('hull.json').filter((s) => info.constituencies!.includes(s.con!));
const faqs = hullFaqs('East Hull', openLatest(schools).length, schools.length);
---
<AreaPage areaKey="hulleast"
  title="East Hull primary schools, admissions and Ofsted · Yorkshire School Checker"
  description="East Hull primary schools: how popular each one is, how places went, Ofsted ratings and the 2027 Reception dates, with Hull’s catchment map."
  h1="East Hull primary schools and admissions"
  lede="Every primary school in East Hull, from Sutton and Bransholme to Marfleet, Holderness Road and Victoria Dock."
  area="East Hull"
  schools={schools}
  groups={[{ label: 'East Hull', note: `${schools.length} primary schools, all academies. Hull publishes its catchments only as a printed map, so the checker shows how popular each school is rather than whether you’re in its catchment.`, schools }]}
  faqs={faqs}
/>
