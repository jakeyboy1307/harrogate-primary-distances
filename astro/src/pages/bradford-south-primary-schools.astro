---
// Area page: Bradford's bradfordsouth area (lib/specs.ts AREA_INFO). The questions every Bradford page shares are in lib/bradford.ts.
import AreaPage from '../components/AreaPage.astro';
import { loadArea, openLatest } from '../lib/areas';
import { bdBorder, bdFaqs, bdTail } from '../lib/bradford';
import { AREA_INFO } from '../lib/specs';
const info = AREA_INFO.bradfordsouth;
const schools = loadArea('bradford.json').filter((s) => info.constituencies!.includes(s.con!));
const faqs: [string, string][] = [
  ...bdFaqs('Bradford South', schools, openLatest(schools).length),
  bdBorder('Bradford', 'From Shelf or Brighouse, that’s Calderdale Council, and from Cleckheaton it’s Kirklees Council'),
  ...bdTail,
];
---
<AreaPage areaKey="bradfordsouth"
  title="Bradford South primary schools: Wibsey, Queensbury, Wyke · Yorkshire School Checker"
  description="Primary schools in Bradford South, from Great Horton, Little Horton and Bowling to Wibsey, Buttershaw, Queensbury, Wyke and Holme Wood: how far places went, which are hardest to get into and Ofsted ratings."
  h1="Bradford South primary schools"
  lede="Every primary school in Bradford South: Great Horton, Little Horton, West Bowling, Wibsey, Odsal, Buttershaw, Queensbury, Low Moor, Wyke, Tong and Holme Wood."
  area="Bradford South"
  schools={schools}
  groups={[{ label: 'Bradford South', note: `${schools.length} Bradford primary schools. Most don’t have catchment areas, so the checker shows how far places went at each one.`, schools }]}
  faqs={faqs}
/>
