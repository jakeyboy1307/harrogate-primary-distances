---
// Area page: the East Riding's Bridlington, Driffield, Hornsea and the Wolds (its constituencies are in lib/specs.ts AREA_INFO). Questions follow
// Google's suggestions (November 2026); the ones every East Riding page shares are in lib/eastriding.ts.
import AreaPage from '../components/AreaPage.astro';
import { loadArea, openLatest } from '../lib/areas';
import { erFaqs, erTail } from '../lib/eastriding';
import { AREA_INFO, COVERED } from '../lib/specs';
import { url } from '../lib/url';
const info = AREA_INFO.bridlington;
const schools = loadArea('east-riding.json').filter((s) => info.constituencies!.includes(s.con!));
const faqs: [string, string][] = [
  ['What is my catchment school in Bridlington?',
    `Put your postcode into the <a href="${url('')}">school catchment checker</a>. It tells you which primary school catchment area you’re in, and your chances at every primary school nearby, in Bridlington, Driffield, Hornsea, Market Weighton and the villages. Every school here has a catchment except the Catholic schools, Our Lady and St Peter in Bridlington and St Mary’s in Market Weighton, which set their own rules.`],
  ...erFaqs('Bridlington', openLatest(schools).length, schools.length),
  ['How do the infant and junior schools work in Bridlington, Driffield and Market Weighton?',
    'Burlington Infant School in Bridlington, Driffield’s two infant schools (Driffield CE and Northfield) and Market Weighton Infant School take children from Reception to Year 2. They then move to the junior school (Burlington Junior, Driffield Junior or Mount Pleasant CE Junior) for Year 3, and you apply again for that place while your child is in Year 2. The checker covers the Reception place at the infant school.'],
  ['Is Bridlington School or Headlands School on here?',
    'No. Bridlington School, Headlands School, Driffield School, Hornsea School and Market Weighton School are secondary schools, and the checker covers primary schools and Reception places only.'],
  ['We live near Filey. Which council do I apply to?',
    `The council for where you live, even when you want a school in another council’s area. From Filey and Hunmanby, that’s North Yorkshire Council, and you can still name East Riding schools on that form. The checker covers ${COVERED} schools, so you can compare both sides of the border.`],
  ...erTail,
];
---
<AreaPage areaKey="bridlington"
  title="Bridlington primary school catchment areas, map and Ofsted · Yorkshire School Checker"
  description="Bridlington, Driffield, Hornsea and Market Weighton primary school catchment areas: find your catchment school, which schools are hardest to get into, Ofsted ratings and the 2027 Reception dates."
  h1="Bridlington, Driffield and Hornsea primary schools and catchment areas"
  lede="Primary school catchment areas for every school in Bridlington, Driffield, Hornsea and Market Weighton, and the villages of the Yorkshire Wolds and the coast from Flamborough to Skipsea."
  area="Bridlington"
  schools={schools}
  groups={[{ label: 'Bridlington, Driffield, Hornsea and the Wolds', note: `${schools.length} East Riding of Yorkshire Council primary and infant schools.`, schools }]}
  faqs={faqs}
/>
