---
// Every area and town page in one place, council by council, with a box that narrows the list as you type. The
// footer links here instead of listing 200 pages on every page. ?q= (from the footer's search, when nothing
// matched exactly) fills the box.
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
import { HUBS } from '../lib/hubs';
import { AREA_INFO, councilLabel } from '../lib/specs';
import { townsOf } from '../lib/towns';
import { byCouncil } from '../lib/places';

const groups = byCouncil().map(([council, areas]) => ({
  council, name: councilLabel(council), hub: HUBS[council],
  areas: areas.map((k) => ({ info: AREA_INFO[k], towns: townsOf(k) })),
}));
const townCount = groups.reduce((n, g) => n + g.areas.reduce((m, a) => m + a.towns.length, 0), 0);
const areaCount = Object.keys(AREA_INFO).length;
---
<Base title="Primary schools by area and town in Yorkshire · Yorkshire School Checker"
  description={`Find the primary school page for your town: ${townCount} towns and suburbs and ${areaCount} areas across Yorkshire, each with catchment areas, Ofsted ratings and who got a place.`}>
  <section class="how-hero wrap">
    <div>
      <h1>Primary schools by area and town</h1>
      <p class="lede">Every town and area the checker covers, council by council. Each page shows its schools, the hardest to get into and the ones that took everyone.</p>
      <div class="ar-find">
        <label class="label" for="arQ">Find your town</label>
        <input class="ar-input" id="arQ" type="search" placeholder="For example Ripon, Roundhay or Hebden Bridge" autocomplete="off" />
        <p class="ar-none" id="arNone" hidden>No town or area by that name. Try a nearby town, or <a href={url('')}>search by postcode</a>.</p>
      </div>
    </div>
  </section>

  <section class="how-sec wrap ar-list">
    {groups.map((g) => (
      <div class="ar-council" data-council>
        <h2>{g.hub ? <a href={url(g.hub.page)}>{g.name}</a> : g.name}</h2>
        <div class="ar-areas">
          {g.areas.map((a) => (
            <div class="ar-area" data-area>
              <h3><a href={url(a.info.page)} data-name={a.info.name}>{a.info.name}</a></h3>
              {a.towns.length > 0 && <ul>{a.towns.map((t) => <li><a href={url(t.page)} data-name={t.label}>{t.name}</a></li>)}</ul>}
            </div>
          ))}
        </div>
      </div>
    ))}
  </section>
</Base>

<script>
  // narrow the list as you type: a town that matches shows with its area; an area that matches shows all its towns
  const q = document.getElementById('arQ') as HTMLInputElement, none = document.getElementById('arNone')!;
  const norm = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();
  function filter() {
    const v = norm(q.value);
    let any = false;
    document.querySelectorAll<HTMLElement>('[data-council]').forEach((c) => {
      let shown = false;
      c.querySelectorAll<HTMLElement>('[data-area]').forEach((a) => {
        const areaHit = !v || norm(a.querySelector('h3 a')!.getAttribute('data-name')!).includes(v);
        let townHit = false;
        a.querySelectorAll<HTMLElement>('li').forEach((li) => {
          const hit = areaHit || norm(li.querySelector('a')!.getAttribute('data-name')!).includes(v);
          li.hidden = !hit; townHit ||= hit;
        });
        a.hidden = !(areaHit || townHit); shown ||= !a.hidden;
      });
      c.hidden = !shown; any ||= shown;
    });
    none.hidden = any;
  }
  q.addEventListener('input', filter);
  const start = new URLSearchParams(location.search).get('q');
  if (start) { q.value = start; filter(); }
</script>

<style>
  .ar-find { margin-top: 32px; display: grid; gap: 10px; max-width: 560px; }
  .ar-input { width: 100%; height: 60px; padding: 0 20px; border: 2.5px solid var(--ink); border-radius: 16px; box-shadow: 4px 4px 0 var(--ink); font: 600 18px var(--body); color: var(--ink); background: #fff; }
  .ar-none { color: var(--muted); }
  .ar-list { padding-top: 0; }
  .ar-council + .ar-council { margin-top: 56px; }
  .ar-council h2 { font-size: 36px; }
  .ar-council h2 a { color: inherit; text-underline-offset: 6px; text-decoration-thickness: 2px; }
  .ar-areas { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 28px 40px; margin-top: 20px; }
  .ar-area h3 { font: 700 17px/1.35 var(--body); }
  .ar-area h3 a { color: var(--ink); text-underline-offset: 3px; }
  .ar-area ul { margin: 8px 0 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 4px 14px; font-size: 15px; }
  .ar-area li a { color: var(--muted); text-decoration-color: var(--line-2); text-underline-offset: 3px; }
  .ar-area li a:hover { color: var(--ink); text-decoration-color: var(--ink); }
  @media (max-width: 760px) { .ar-council h2 { font-size: 28px; } .ar-input { height: 54px; font-size: 17px; } }
</style>
