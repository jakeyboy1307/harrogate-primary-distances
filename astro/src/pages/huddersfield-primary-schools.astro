---
// Area page: Kirklees's huddersfield area (lib/specs.ts AREA_INFO). The questions every Kirklees page shares are in lib/kirklees.ts.
import AreaPage from '../components/AreaPage.astro';
import { loadArea, openLatest } from '../lib/areas';
import { kBorder, kFaqs, kTail } from '../lib/kirklees';
import { AREA_INFO } from '../lib/specs';
const info = AREA_INFO.huddersfield;
const schools = loadArea('kirklees.json').filter((s) => info.constituencies!.includes(s.con!));
const faqs: [string, string][] = [
  ...kFaqs('Huddersfield', openLatest(schools).length, schools.length),
  ['How do the infant and junior schools work in Huddersfield?',
    'Birkby Infant, Netherhall St James CE Infant, Netherton Infant and Berry Brow Infant take children from Reception to Year 2. They then move to a junior school (Birkby Junior, Netherhall Learning Campus Junior, South Crosland CE Junior or Newsome Junior) for Year 3, and you apply again for that place while your child is in Year 2. The checker covers the Reception place at the infant school.'],
  kBorder('Huddersfield', 'From Brighouse or Elland, that’s Calderdale Council'),
  ...kTail,
];
---
<AreaPage areaKey="huddersfield"
  title="Huddersfield primary school catchment areas, map and Ofsted · Yorkshire School Checker"
  description="Huddersfield primary school catchment areas (priority admission areas): find your catchment school, which schools are hardest to get into, Ofsted ratings and the 2027 Reception dates."
  h1="Huddersfield primary schools and catchment areas"
  lede="Primary school catchment areas for every school in Huddersfield, from Birkby, Fixby and Sheepridge to Almondbury, Lepton, Newsome and Lockwood."
  area="Huddersfield"
  schools={schools}
  groups={[{ label: 'Huddersfield', note: `${schools.length} primary, infant and first schools.`, schools }]}
  faqs={faqs}
/>
