---
// The page a business reads before buying a placement: who visits, where the slots are, when, and the rules.
// Prices are a DRAFT starting point (see the money plan). Not linked from search until it's agreed.
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
const slots = [
  ['School uniform', 'In the panel for each school you supply, seen by parents choosing that school.', 'From £40 a month per area', 'Uniform shops, PE kit, book bags'],
  ['Featured in results', 'One card among the schools after a postcode search, never above the first four.', 'From £150 a month per area', 'Independent schools, nurseries, after-school care'],
  ['School profile', 'A school’s own open days and welcome note, in its panel.', 'From £150 a year', 'Primary schools and academy trusts'],
  ['Near this school', 'One local service in each school’s panel, shared in turn with other sponsors.', 'From £60 a month per area', 'Wraparound care, clubs, estate agents, tutors'],
  ['Get ready for September', 'On every parent’s plan page, alongside their list of schools.', 'From £50 a month per area', 'Uniform, shoes, care, tutoring'],
  ['Area page sponsor', 'Your name under the heading of the Harrogate or York area page, one business per page.', 'From £100 a month', 'Estate agents, mortgage brokers'],
];
const season = [
  ['September to January', 'Peak', 'Parents compare schools and apply. Forms close on 15 January.'],
  ['February to April', 'Steady', 'Waiting for offer day on 16 April. Parents look at backups and moves.'],
  ['April to August', 'Getting ready', 'Uniform, shoes, wraparound care and summer clubs.'],
];
---
<Base title="Advertise with us · Yorkshire School Checker" description="Reach Harrogate and York parents while they choose a primary school. Clearly labelled placements for local businesses and schools." index={false}>
  <section class="how-hero wrap">
    <div>
      <h1>Reach parents choosing a primary school</h1>
      <p class="lede">Parents in Harrogate, York and the villages between use the checker to choose a Reception place. Be there when they’re planning for September.</p>
      <p class="area-acts"><a class="btn btn-primary" href="mailto:advertise@yorkshireschoolchecker.co.uk?subject=Advertising">Get in touch</a></p>
    </div>
  </section>

  <section class="how-sec sec-pale wrap">
    <h2>Where you can appear</h2>
    <p class="intro">Every placement is local, labelled “Sponsored”, and shown only to parents searching in your area.</p>
    <div class="adv-grid">
      {slots.map(([h, p, price, who]) => (
        <div class="adv-slot"><h3>{h}</h3><p>{p}</p><p class="adv-who">Good for: {who}</p><p class="adv-price">{price}</p></div>
      ))}
    </div>
  </section>

  <section class="how-sec wrap">
    <h2>When parents are looking</h2>
    <div class="adv-season">
      {season.map(([when, tag, what]) => <div><span class="ad-label">{tag}</span><h3>{when}</h3><p>{what}</p></div>)}
    </div>
  </section>

  <section class="how-sec wrap" style="border-top:1px solid var(--line)">
    <h2>Our rules</h2>
    <ul class="adv-rules">
      <li><b>Paying never changes the results.</b> No school is moved up, relabelled or hidden because of a sponsor.</li>
      <li><b>Every placement says Sponsored</b>, as the advertising rules (the CAP Code) require.</li>
      <li><b>No tracking.</b> We don’t use ad networks or cookies. Your link carries a tag, so your own stats show the visits we send.</li>
      <li><b>Local and relevant only.</b> Businesses that help families starting school. No gambling, payday loans or alcohol.</li>
    </ul>
  </section>
</Base>

<style>
  .area-acts { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .adv-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; margin-top: 32px; }
  .adv-slot { background: #fff; border: 2px solid var(--ink); border-radius: 16px; padding: 22px; display: grid; gap: 8px; align-content: start; }
  .adv-slot h3 { font: 700 20px var(--body); }
  .adv-slot p { color: var(--muted); line-height: 1.5; }
  .adv-who { font-size: 14px; }
  .adv-price { font-weight: 700; color: var(--ink) !important; margin-top: 4px; }
  .adv-season { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; margin-top: 28px; }
  .adv-season h3 { font: 700 20px var(--body); margin: 10px 0 6px; }
  .adv-season p { color: var(--muted); line-height: 1.5; }
  .adv-rules { margin: 24px 0 0; padding-left: 20px; display: grid; gap: 12px; max-width: 760px; font-size: 18px; line-height: 1.55; color: var(--muted); }
  .adv-rules b { color: var(--ink); }
  @media (max-width: 760px) { .adv-season { grid-template-columns: 1fr; } }
</style>
