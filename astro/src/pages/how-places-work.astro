---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
import { COUNCILS, placesGo } from '../lib/engine';
import { AREA_INFO, COVERED, NY_PLACES } from '../lib/specs';
const ny = COUNCILS['North Yorkshire'], cyc = COUNCILS.York;
// every council except North Yorkshire and York (whose orders section 2 spells out), with the order its places go in
const others = Object.entries(COUNCILS).filter(([k]) => k !== 'North Yorkshire' && k !== 'York').map(([, c]) => c)
  .sort((a, b) => a.name.localeCompare(b.name));
const ext = (href: string, text: string) => `<a href="${href}" target="_blank" rel="noopener">${text}</a>`;
const DFE = 'https://explore-education-statistics.service.gov.uk/find-statistics/primary-and-secondary-school-applications-and-offers';
// Where each council's figures and catchments come from (the README's Sources list, in parents' words).
// Keep in step with the README when a council's sources change.
const councilSources: [string, string][] = [
  ['Barnsley', `${ext('https://www.barnsley.gov.uk/services/schools-and-education/school-admissions-and-transfers/primary-school-places/', 'Barnsley Council’s guides for parents')}, 2024 to 2026 entry: every full school’s last distance and how its places were shared out. Barnsley’s primary schools have no catchments.`],
  ['Bradford', `${ext('https://www.bradford.gov.uk/media/dy1lr1hm/applying-for-a-primary-school-detailed-guide-for-september-2027.pdf', 'Bradford Council’s primary guides')} for 2023 and 2026, and the national first-choice figures for 2024 and 2025. Priority areas from the ${ext('https://bso.bradford.gov.uk/content/admissions/priority-areas', 'council’s priority area maps')}.`],
  ['Calderdale', `${ext('https://dataworks.calderdale.gov.uk/dataset/vq9q6', 'Calderdale Council’s primary preferences and allocations')}, 2023 to 2026 entry: places, preferences and the furthest child offered a place at full schools. Calderdale’s primary schools have no catchments.`],
  ['Doncaster', `The national first-choice figures, as City of Doncaster Council publishes no cut-off distances. Catchments from the ${ext('https://maps.doncaster.gov.uk/portal/apps/experiencebuilder/experience/?id=862cc0a6abb244928a1c5ca0462d6f8e', 'council’s catchment finder')}.`],
  ['East Riding', `East Riding of Yorkshire Council’s summaries of primary school allocations, 2024 to 2026 entry, and catchments from the ${ext(COUNCILS['East Riding of Yorkshire'].catchMap, 'council’s catchment finder')}.`],
  ['Hull', `${ext('https://www.hull.gov.uk/applications-transfers/primary-school-applications', 'Hull City Council’s guide to primary admissions')}: each school’s places and how the latest year’s went. Its ${ext(COUNCILS['Kingston upon Hull, City of'].catchMap, 'catchment map')} is a scanned picture, so we can’t check your address against it.`],
  ['Kirklees', `${ext('https://www.kirklees.gov.uk/beta/admissions/pdf/reception-by-preference-and-criteria-26.pdf', 'Kirklees Council’s Reception allocations by preference and criteria')}, 2023 to 2026 entry. Priority admission areas from the ${ext(COUNCILS.Kirklees.catchMap, 'council’s public map')}.`],
  ['Leeds', `Leeds City Council’s cut-off distances, 2024 to 2026 entry, ${ext('https://datamillnorth.org/dataset/primary-school-allocations', 'Data Mill North’s primary school allocations')} for 2023, and the council’s primary catchment maps for 2026 admissions.`],
  ['Middlesbrough', `${ext('https://www.middlesbrough.gov.uk/schools-and-education/school-admissions/school-admissions-allocation-statistics/', 'Middlesbrough Council’s school admission statistics')}, 2023 to 2026 entry. Its ${ext(COUNCILS.Middlesbrough.catchMap, 'admission zones')} are only a PDF map, so we can’t check your address against them.`],
  ['North Yorkshire', `${ext('https://hub.datanorthyorkshire.org/dataset/school-admissions-2026-2027-yearly-statistics-primary-and-secondary-school', 'North Yorkshire Council’s admissions statistics')}, 2023 to 2026 entry, for ${NY_PLACES} and the villages round York. Catchments from the ${ext(ny.catchMap, 'council’s school maps')}, updated September 2025, which it publishes for reference only.`],
  ['Redcar and Cleveland', `The national first-choice figures, as Redcar and Cleveland Council publishes no figures on who got in and no maps of its admission zones.`],
  ['Rotherham', `${ext('https://www.rotherham.gov.uk/downloads/download/728/primary-application-booklet', 'Rotherham Council’s primary application booklet')} for how 2026’s places went, and the national first-choice figures. Its catchments are only pictures on ${ext(COUNCILS.Rotherham.catchMap, 'the council’s web map')}, so we can’t check your address against them.`],
  ['Sheffield', `${ext('https://www.sheffield.gov.uk/sites/default/files/2026-04/oversubscribed_infant_and_primary_schools_2026.pdf', 'Sheffield City Council’s oversubscribed schools lists')}, 2024 to 2026 entry: the last child’s distance and refusals at each full school. Catchments from the ${ext('https://sheffieldcitycouncil.cloud.esriuk.com/server/rest/services/AGOL/OpenData/FeatureServer/1', 'council’s open data')}.`],
  ['Wakefield', `${ext('https://www.wakefield.gov.uk/media/43xpw5x4/primaryguide-27-28.docx', 'Wakefield Council’s Primary Guide for Parents')} for how 2026’s places went, and the national first-choice figures. Its catchments are only an ${ext(COUNCILS.Wakefield.catchMap, 'address search')}, so we can’t check your address against them.`],
  ['York', `${ext('https://data.yorkopendata.org/dataset/pupil-level-outcome-summary-primary', 'City of York Council’s anonymised list of every Reception applicant')} for 2022, 2023, 2025 and 2026 entry (its 2024 list is incomplete, so we leave that year out), and its ${ext(cyc.catchMap, 'primary schools map')} for catchments.`],
];
const everywhere: [string, string][] = [
  ['National first-choice figures', `The Department for Education’s ${ext(DFE, 'applications and offers')} for every school in England: how many families put each school first and how many of them got it. We use them where a council publishes nothing on who got the last place.`],
  ['Distances', 'Walking routes from OpenStreetMap, from your postcode’s centre to the school. Expect differences of 0.1 mile or more. Where a council measures in a straight line, so do we.'],
  ['Ofsted', 'Ofsted management information as at 30 September 2026, including the new report cards, which rate each area rather than giving one grade.'],
  ['School details', 'Locations, school types and websites from Get Information about Schools, the government’s register. Phone numbers from the same register, and emails from each school’s own website.'],
];
// the catchment questions in section 1, for search engines
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: [
  ['How do school catchment areas work?', 'A catchment area is the patch of streets a council links to a school. Children who live inside it get priority for its Reception places, ahead of most children from outside it. Children in care always come first, and inside each group brothers and sisters of pupils go first, then whoever lives nearest.'],
  ['What is my catchment school?', 'It’s the school whose catchment area your home is in. The council draws the lines, so your catchment school isn’t always the nearest one. A few homes sit in two catchments, and a few in none.'],
  ['What is my school catchment area?', 'Put your postcode into the Yorkshire School Checker. It tells you which catchment you’re in and your chances at every primary school nearby, using the councils’ own catchment maps.'],
  ['Is there a school catchment area map?', `Yes, most councils publish one: North Yorkshire Council’s covers every school in the county, including ${NY_PLACES}, City of York Council publishes a primary schools map, and Leeds, Sheffield, Kirklees, Doncaster and the East Riding have their own. A few councils, such as Calderdale, Barnsley and most of Bradford, have no catchments at all.`],
  ['Does living in the catchment guarantee a place?', 'No. It puts you near the front of the queue, but a popular school can fill up with catchment children alone.'],
].map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) };
// Coppice Valley's real last-place distances (miles) from the council's figures, against a home 0.75 miles away
const MAXMI = 1.5, YOU = 0.75;
const bars = [[2026, 1.22], [2025, 0.68], [2024, 0.81], [2023, 0.64]] as const;
const pct = (mi: number) => `${(mi / MAXMI) * 100}%`;
const tickets = [
  ['1', 'Looked-after children', 'Children in care, or who used to be, always come first.'],
  ['2', 'Medical or social need', 'Only cases the council has approved, with evidence.'],
  ['3', 'Living in the catchment', 'We check your postcode against the council’s catchment map. Near a boundary? Check your exact address on their map.'],
  ['4', 'Children of staff', 'Children of people who work at the school.'],
  ['5', 'Everyone else', 'Children from outside the catchment, if places are left.'],
];
const phrases = [
  ['“Everyone in the catchment, plus others within 1.22 mi”', 'Every child in the catchment got a place, and children outside it got one if they lived within 1.22 miles.'],
  ['“Only children in the catchment, within 0.27 mi”', 'Places ran out inside the catchment. Nobody outside it got in, and inside it only children within 0.27 miles did.'],
  ['“Everyone in the catchment, plus brothers and sisters of pupils”', 'From outside the catchment, only children with a brother or sister already there got in.'],
  ['“By the school’s own rules”', 'Academies, voluntary aided and foundation schools decide their own order. Faith schools may put church members first.'],
];
---
<Base title="How do school catchment areas work? · Yorkshire School Checker" description={`How school catchment areas work in ${COVERED}: what your catchment school is, where to find the catchment area map, who gets a Reception place first, and what “last place” means.`} active="how">
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <section class="how-hero wrap">
    <div>
      <h1>How do school catchment areas work?</h1>
      <p class="lede">The rules sound complicated, but they boil down to a queue, and your catchment area decides where you stand in it. Here’s what a catchment is, who goes first, what “last place” means, and how to read the numbers we show you.</p>
    </div>
    <nav class="toc" aria-label="On this page">
      <span class="hand">on this page</span>
      <a href="#catchment">1. What is a school catchment area?</a>
      <a href="#queue">2. Who gets a place first</a>
      <a href="#last-place">3. What “last place” means</a>
      <a href="#reading">4. Reading the year by year</a>
      <a href="#five">5. Picking your schools</a>
      <a href="#sources">6. Where our numbers come from</a>
    </nav>
  </section>

  <section class="how-sec wrap" id="catchment">
    <h2>1. What is a school catchment area?</h2>
    <p class="intro">A catchment area is the patch of streets a council links to a school. Most community and voluntary controlled primary schools in {COVERED} have one. Children who live inside it get priority for that school’s Reception places, ahead of most children from outside it.</p>
    <div class="sources">
      <div><h3>What is my catchment school?</h3><p>It’s the school whose catchment area your home is in. The council draws the lines, not the map distance, so your catchment school isn’t always the nearest one. A few homes sit in two catchments, and a few in none.</p></div>
      <div><h3>What is my school catchment area?</h3><p>Put your postcode into the <a href={url('')}>school catchment checker</a>. It tells you which catchment you’re in and your chances at every primary school nearby, using the councils’ own catchment maps.</p></div>
      <div><h3>Is there a school catchment area map?</h3><p>Yes, from each council that has catchments: <a href={ny.catchMap} target="_blank" rel="noopener">North Yorkshire Council’s map</a> for {NY_PLACES} and the rest of the county, <a href={cyc.catchMap} target="_blank" rel="noopener">City of York Council’s primary schools map</a> for York, and each council’s own, linked from <a href="#sources">where our numbers come from</a>. Use them to check your exact address if you’re near a boundary.</p></div>
      <div><h3>Does living in the catchment guarantee a place?</h3><p>No. It puts you near the front of the queue, but a popular school can fill up with catchment children alone. The year by year figures on each school’s page show whether that has happened.</p></div>
    </div>
    <p class="intro" style="margin-top:28px">See every school’s catchment and figures: primary school catchment areas for {Object.values(AREA_INFO).map((a, i, all) => <>{i ? (i === all.length - 1 ? ' and ' : ', ') : ''}<a href={url(a.page)}>{a.short}</a></>)}.</p>
  </section>

  <section class="how-sec sec-pale wrap" id="queue">
    <h2>2. Who gets a place first</h2>
    <p class="intro">For community and voluntary controlled schools, North Yorkshire Council works down this list until the places run out.</p>
    <ol class="tickets">
      {tickets.map(([n, h, p]) => <li class={`ticket${n === '3' ? ' hot' : ''}`}><b>{n}</b><h3>{h}</h3><p>{p}</p></li>)}
    </ol>
    <div class="tiebreak">
      <div><h3>Inside each group, who wins?</h3><p>Brothers and sisters of pupils already at the school go first. After that, whoever lives nearest. That’s why distance matters so much.</p></div>
      <div class="dashed"><h3>Academies, voluntary aided, foundation and faith schools</h3><p>These set their own rules, and faith schools may put church members first. We mark them “own rules” so you know to read their policy.</p></div>
    </div>
    <div class="tiebreak" id="york">
      <div><h3>In York</h3><p>City of York Council’s order is a little different: looked-after children, then children in the catchment with a brother or sister at the school, then the rest of the catchment, then medical or social need, then brothers and sisters from outside it, then whoever has the shortest safe walk.</p></div>
      <div class="dashed"><h3>No “last place” for York schools</h3><p>York doesn’t publish how far the last place went. So for York schools we show how many children from inside and outside the catchment got a place each year, worked out from the council’s anonymised list of every applicant.</p></div>
    </div>
    <h3 class="how-sub" id="other-councils">Every other council’s order</h3>
    <p class="intro">Each council has its own list for its community and voluntary controlled schools. After children in care, this is how they go.</p>
    <div class="sources">
      {others.map((c) => <div><h3>{c.name}</h3><p>{placesGo(c)}.</p></div>)}
    </div>
  </section>

  <section class="how-sec wrap split" id="last-place">
    <div>
      <h2>3. What “last place” means</h2>
      <p class="intro">It’s how far from the school the last child offered a place on distance lived. It’s measured the way the school measures it, usually the walking route.</p>
      <p class="intro">It is not a fixed boundary. It moves every year depending on how many families apply and where they live.</p>
    </div>
    <figure class="chart" style="margin:0">
      <div class="chart-head"><h3>Coppice Valley, last place each year</h3><span>Outside-catchment places</span></div>
      <div class="bars" role="img" aria-label="Last place: 1.22 miles in 2026, 0.68 in 2025, 0.81 in 2024 and 0.64 in 2023. A home 0.75 miles away would have got in in 2026 and 2024 only.">
        {bars.map(([y, mi]) => (
          <div class="bar-row"><span>{y}</span><div class="bar-track"><div class={`bar${mi < YOU ? ' miss' : ''}`} style={`width:${pct(mi)}`}></div></div><span class={`val${mi < YOU ? ' miss' : ''}`}>{mi.toFixed(2)} mi</span></div>
        ))}
        <div class="you-line" style={`left:calc(var(--lab) + var(--gap) + (100% - var(--lab) - var(--val) - 2 * var(--gap)) * ${YOU / MAXMI})`}></div>
        <span class="you-tag" style={`left:calc(var(--lab) + var(--gap) + (100% - var(--lab) - var(--val) - 2 * var(--gap)) * ${YOU / MAXMI})`}>you, {YOU} mi</span>
      </div>
      <figcaption class="chart-foot"><span><i></i>You’d have got in</span><span><i class="miss"></i>You’d have missed out</span><span>Same house, same school, different answer each year.</span></figcaption>
    </figure>
  </section>

  <section class="how-sec sec-pale wrap" id="reading">
    <h2>4. Reading the year by year</h2>
    <p class="intro">Every school shows a line like these for each year. Here’s what each one means in plain English.</p>
    <div class="phrases">{phrases.map(([h, p]) => <div class="phrase"><h3>{h}</h3><p>{p}</p></div>)}</div>
    <p class="worth"><span class="tag">worth knowing</span><span>Our labels don’t count brothers and sisters. If you already have a child at a school, your chances there are better than we show.</span></p>
  </section>

  <section class="how-sec wrap split" id="five">
    <div>
      <h2>5. Picking your schools</h2>
      <p class="intro">North Yorkshire’s, York’s, Calderdale’s, Leeds’, Bradford’s and Wakefield’s forms take up to five schools, and East Riding’s, Hull’s, Kirklees’, Middlesbrough’s, Redcar and Cleveland’s, Sheffield’s, Barnsley’s, Doncaster’s and Rotherham’s up to three. Each one is considered equally, without knowing where you ranked it.</p>
      <p class="intro">If more than one could take you, you’re offered the one highest on your list. So put your real favourite first, and include at least one safe bet.</p>
      <p style="margin-top:24px"><a class="btn btn-primary" href={url('plan/')}>Start my plan</a></p>
    </div>
    <div class="example-list">
      <span class="hand">say your list looks like this…</span>
      <div class="ex-row full"><b>1</b><span>Your favourite school</span><span class="r">Full before it got to you</span></div>
      <div class="ex-row won"><b>2</b><span>Your second choice</span><span class="r">Has room, so you’re offered this one</span></div>
      <div class="ex-row"><b>3</b><span>Your safe bet</span><span class="r">Could also take you, but it’s lower down</span></div>
      <p class="muted" style="font-size:15px;padding-top:10px">Putting your favourite first never costs you a place at the others. The council just goes for the highest school on your list that has room.</p>
    </div>
  </section>

  <section class="how-sec wrap" id="sources" style="border-top:1px solid var(--line)">
    <h2>6. Where our numbers come from</h2>
    <p class="intro">Every figure comes from a council or the government, and every page links to its source. We don’t fill gaps with guesses: where a council hasn’t published something, we say so. The figures were last refreshed in November 2026, for September 2027 entry.</p>
    <h3 class="how-sub">Council by council</h3>
    <div class="sources">
      {councilSources.map(([n, h]) => <div><h3>{n}</h3><p set:html={h} /></div>)}
    </div>
    <h3 class="how-sub">Everywhere</h3>
    <div class="sources">
      {everywhere.map(([n, h]) => <div><h3>{n}</h3><p set:html={h} /></div>)}
    </div>
    <p class="caveat">Junior schools like Oatlands Junior and Saltergate Junior take children into Year 3, so they aren’t included. Always check the school’s current admissions policy and the council’s own figures before you apply. Key dates are from the councils’ primary admissions timetables for 2027 to 2028, which all share the same national dates. Spotted a mistake? <a href={url('about/#contact')}>Tell us</a> and we’ll put it right.</p>
  </section>
</Base>
