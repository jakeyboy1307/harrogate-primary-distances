---
// Area page: the East Riding's Beverley and Holderness (its constituencies are in lib/specs.ts AREA_INFO). Questions follow
// Google's suggestions (November 2026); the ones every East Riding page shares are in lib/eastriding.ts.
import AreaPage from '../components/AreaPage.astro';
import { loadArea, openLatest } from '../lib/areas';
import { erFaqs, erTail } from '../lib/eastriding';
import { AREA_INFO, COVERED } from '../lib/specs';
import { url } from '../lib/url';
const info = AREA_INFO.beverley;
const schools = loadArea('east-riding.json').filter((s) => info.constituencies!.includes(s.con!));
const faqs: [string, string][] = [
  ['What is my catchment school in Beverley?',
    `Put your postcode into the <a href="${url('')}">school catchment checker</a>. It tells you which primary school catchment area you’re in, and your chances at every primary school nearby, in Beverley, Molescroft, Hedon, Withernsea and the Holderness villages. Every school here has a catchment except St John of Beverley Catholic Primary School, which sets its own rules.`],
  ...erFaqs('Beverley', openLatest(schools).length, schools.length),
  ['What about the Beverley Grammar or Beverley High School catchment area?',
    'The checker covers primary schools and Reception places only. Beverley Grammar School and Beverley High School are secondary schools, and despite its name Beverley Grammar doesn’t set an entrance test. Check East Riding of Yorkshire Council’s secondary admissions pages for their catchments.'],
  ['Looking for Beverley Primary School?',
    'There isn’t a school of that name in Beverley, East Yorkshire, though schools elsewhere share it. Beverley’s primary schools include Beverley Minster, St Nicholas, St Mary’s, Swinemoor, Keldmarsh and St John of Beverley, and they’re listed above.'],
  ['We live in Hull. Which council do I apply to?',
    'Hull City Council, as the council where you live, even when you want an East Riding school. You can name East Riding schools on that form. The checker doesn’t cover Hull’s own schools yet.'],
  ...erTail,
];
---
<AreaPage areaKey="beverley"
  title="Beverley primary school catchment areas, map and Ofsted · Yorkshire School Checker"
  description="Beverley, Hedon and Withernsea primary school catchment areas: find your catchment school, which schools are hardest to get into, Ofsted ratings and the 2027 Reception dates."
  h1="Beverley, Hedon and Withernsea primary schools and catchment areas"
  lede="Primary school catchment areas for every school in Beverley, Molescroft, Hedon and Withernsea, and the Holderness villages out to the coast at Easington."
  area="Beverley"
  schools={schools}
  groups={[{ label: 'Beverley and Holderness', note: `${schools.length} East Riding of Yorkshire Council primary and infant schools.`, schools }]}
  faqs={faqs}
/>
