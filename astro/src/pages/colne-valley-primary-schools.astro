---
// Area page: Kirklees's colnevalley area (lib/specs.ts AREA_INFO). The questions every Kirklees page shares are in lib/kirklees.ts.
import AreaPage from '../components/AreaPage.astro';
import { loadArea, openLatest } from '../lib/areas';
import { kBorder, kFaqs, kTail } from '../lib/kirklees';
import { AREA_INFO } from '../lib/specs';
const info = AREA_INFO.colnevalley;
const schools = loadArea('kirklees.json').filter((s) => info.constituencies!.includes(s.con!));
const faqs: [string, string][] = [
  ...kFaqs('Holmfirth', openLatest(schools).length, schools.length),
  ['How do the infant and junior schools work here?',
    'Lindley CE Infant, Marsden Infant, New Mill Infant and Reinwood Infant take children from Reception to Year 2. They then move to the junior school next door (Lindley Junior, Marsden Junior, New Mill Junior or Reinwood Junior) for Year 3, and you apply again for that place while your child is in Year 2. The checker covers the Reception place at the infant school.'],
  kBorder('Holmfirth', 'From Saddleworth, that’s Oldham Council'),
  ...kTail,
];
---
<AreaPage areaKey="colnevalley"
  title="Holmfirth and Colne Valley primary school catchment areas and Ofsted · Yorkshire School Checker"
  description="Holmfirth, Honley, Meltham, Slaithwaite, Marsden and Golcar primary school catchment areas: find your catchment school, which schools are hardest to get into, Ofsted ratings and the 2027 Reception dates."
  h1="Holmfirth and Colne Valley primary schools"
  lede="Primary school catchment areas for every school in the Colne and Holme valleys: Lindley, Golcar, Slaithwaite, Marsden, Meltham, Honley, Holmfirth and the villages to Holme."
  area="Holmfirth"
  schools={schools}
  groups={[{ label: 'Holmfirth and the Colne Valley', note: `${schools.length} primary, infant and first schools.`, schools }]}
  faqs={faqs}
/>
