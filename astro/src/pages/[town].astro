---
// A town page: "Primary schools in Knaresborough". Written for what parents type (Google's suggestions, November
// 2026): "primary schools in <town>", "best primary schools in <town>", "<town> catchment", "<town> school
// holidays", "<town> primary school places". The towns and which schools each takes are in lib/towns.ts; the page
// itself is the area page's, with the town's own schools and answers.
import AreaPage from '../components/AreaPage.astro';
import { townPages, type TownPage } from '../lib/towns';
import { hardest, openToAll, outstanding } from '../lib/areas';
import { COUNCILS } from '../lib/engine';
import { pageOf, shortOf } from '../lib/schoolpages';
import { AREA_INFO, listOf, NY_TERM_DATES, ER_TERM_DATES, HULL_TERM_DATES, CALD_TERM_DATES, KIRK_TERM_DATES, LEEDS_TERM_DATES, BRAD_TERM_DATES, WAKE_TERM_DATES, SHEF_TERM_DATES, BARN_TERM_DATES, DON_TERM_DATES, ROT_TERM_DATES } from '../lib/specs';
import { url } from '../lib/url';

export function getStaticPaths() {
  return townPages().map((t) => ({ params: { town: t.slug }, props: { t } }));
}
const { t } = Astro.props as { t: TownPage };
const schools = [...t.core, ...t.near];
const c = COUNCILS[t.council];
const area = AREA_INFO[t.area];
const TERMS: Record<string, string> = {
  'North Yorkshire': NY_TERM_DATES, 'East Riding of Yorkshire': ER_TERM_DATES, 'Kingston upon Hull, City of': HULL_TERM_DATES,
  Calderdale: CALD_TERM_DATES, Kirklees: KIRK_TERM_DATES, Leeds: LEEDS_TERM_DATES, Bradford: BRAD_TERM_DATES,
  Wakefield: WAKE_TERM_DATES, Sheffield: SHEF_TERM_DATES, Barnsley: BARN_TERM_DATES, Doncaster: DON_TERM_DATES, Rotherham: ROT_TERM_DATES,
};
const link = (urn: number, text?: string) => { const p = pageOf(urn)!; return `<a href="${url(`schools/${p.slug}/`)}">${text ?? shortOf(p.s.name)}</a>`; };
const ext = (href: string, text: string) => `<a href="${href}" target="_blank" rel="noopener">${text}</a>`;
const names = (xs: { urn: number }[]) => listOf(xs.map((s) => link(s.urn)));

// Ofsted: the latest graded outcome, as the area pages count it
const grade = (s: (typeof schools)[number]) => s.of?.kind === 'grade' ? s.of.grade : s.of?.kind === 'ungraded' ? s.of.graded?.grade : undefined;
const top = outstanding(schools), good = schools.filter((s) => grade(s) === 'Good');
const topIn = outstanding(t.core);
const hard = hardest(schools, 3);
const open = openToAll(t.core);
const n = t.core.length, inWords = n === 1 ? 'one primary school' : `${n} primary schools`;
const nearText = t.kind === 'suburb' ? `the streets around it` : `the villages around it`;
const where = t.kind === 'suburb' ? `in and around ${t.label}` : `in ${t.name} and ${nearText}`;

const faqs: [string, string][] = [
  [`What are the best primary schools in ${t.name}?`,
    `There’s no official ranking, so be wary of league tables. Ofsted is the fairest guide, alongside a visit. ${top.length
      ? `Of the ${schools.length} schools on this page, ${top.length === 1 ? 'one was' : `${top.length} were`} rated Outstanding at ${top.length === 1 ? 'its' : 'their'} latest graded inspection: ${names(top)}${good.length ? `, and ${good.length} more Good` : ''}.`
      : `None of the ${schools.length} schools on this page was rated Outstanding at its latest graded inspection${good.length ? `; ${good.length} were rated Good` : ''}.`} Most schools inspected since late 2025 have a report card instead of one grade, so open each school for its latest report.`],
  [`Which ${t.name} primary schools are hardest to get into?`,
    hard.length
      ? `In the latest year each council published: ${hard.map((h) => `${link(h.urn)} (${h.who.replace(/^./, (x) => x.toLowerCase())}, ${h.year})`).join('; ')}. Put your postcode into the <a href="${url('')}">checker</a> to see whether you’d have got in from your address.`
      : `None stands out: in the latest year each council published, every school here either took everyone who applied or took children from well over a mile away. Put your postcode into the <a href="${url('')}">checker</a> to see your own chances.`],
  [`How many primary schools are there in ${t.name}?`,
    `There ${n === 1 ? 'is' : 'are'} ${inWords} in ${t.label}${topIn.length ? ` (${topIn.length} rated Outstanding)` : ''}, and this page lists the ${t.near.length} nearest others ${t.kind === 'suburb' ? 'around it' : 'in the villages around it'}, within ${t.nearMiles} miles. ${open.length ? `${open.length === n ? 'All' : `${open.length}`} of the ${n} in ${t.name} took everyone who applied in every year published.` : ''}`],
  [`What is my catchment school in ${t.name}?`,
    c.noCatch
      ? `${c.noCatch}. Put your postcode into the <a href="${url('')}">school checker</a> to see your distance to every school ${where}, and how far the last place went each year.`
      : c.mapData === false
        ? `${c.name} ${c.mapNote}, so the checker can’t tell you which catchment you’re in. ${c.mapTip ? c.mapTip.replace(/\{map:([^}]*)\}/, (_, x) => ext(c.catchMap, x)) : `Find your address on ${ext(c.catchMap, 'the council’s map')}`}, then put your postcode into the <a href="${url('')}">checker</a> to see your distance to every school and how far the last place went.`
        : `Put your postcode into the <a href="${url('')}">school catchment checker</a>. It tells you which ${t.name} primary school catchment you’re in, using ${ext(c.catchMap, `${c.name}’s own catchment map`)}, and your chances at every school nearby. Near a boundary? Check your exact address on the council’s map.`],
  [`How do I apply for a Reception place in ${t.name} for September 2027?`,
    `Apply online to your own council by Friday 15 January 2027, even for a school over the border. For ${t.name} that’s ${ext(c.apply, c.name)}, whose form takes up to ${c.prefs} schools, in the order you want them. Children born between 1 September 2022 and 31 August 2023 start Reception in September 2027.`],
  [`When will I know which school we’ve got?`,
    'Offers go out on national offer day, Friday 16 April 2027, by email from the council. If you miss out, you can join waiting lists and appeal.'],
  [`When are the ${t.name} school holidays?`,
    TERMS[t.council]
      ? `Community and voluntary controlled schools follow ${ext(TERMS[t.council], `${c.name}’s term and holiday dates`)}. Academies, free schools and voluntary aided schools can set their own, so check with the school: open it here for its phone number and website.`
      : `Each school publishes its own term dates. Open the school here for its phone number and website.`],
  [`Does this cover secondary schools in ${t.name}?`,
    `Not yet. The Yorkshire School Checker covers primary, infant and first schools and Reception places only.`],
];

const h1 = `Primary schools in ${t.label}`;
const title = `Primary schools in ${t.label}: catchments, Ofsted and places · Yorkshire School Checker`;
const description = `All ${schools.length} primary schools ${where}: which are hardest to get into, which took everyone, Ofsted ratings, catchment areas and the dates for Reception in September 2027.`;
const lede = `The ${inWords} in ${t.label}, and the ${t.near.length} nearest ${t.kind === 'suburb' ? 'around it' : 'in the villages around it'}: who got a place each year, Ofsted ratings and how to find your catchment school. Part of the <a href="${url(area.page)}">${area.name} primary schools</a> guide.`;
const groups = [
  { label: `In ${t.name}`, note: `Within ${t.kind === 'town' ? 'a mile and a half' : t.kind === 'village' ? 'a mile' : 'three quarters of a mile'} of the centre of ${t.name}.`, schools: t.core },
  ...(t.near.length ? [{ label: `Near ${t.name}`, note: `The nearest other schools, within ${t.nearMiles} miles.`, schools: t.near }] : []),
];
---
<AreaPage areaKey={t.area} here={{ name: t.name, page: t.page }}
  title={title} description={description} h1={h1} lede={lede} area={t.name}
  schools={schools} groups={groups} faqs={faqs}
/>
